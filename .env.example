# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env de verdade (já está no .gitignore).

# Servidor
APP_HOST=127.0.0.1
APP_PORT=8080

# Banco de dados (MySQL — o framework só tem driver luasql-mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=crescent_db
DB_USER=crescent
DB_PASSWORD=senha_segura

# Autenticação (JWT) — obrigatório definir em produção
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# CORS
CORS_METHODS=GET,POST,PUT,PATCH,DELETE
CORS_ORIGIN=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=100

# Hash de senha (PBKDF2-HMAC-SHA256). Ver comentário em
# crescent/utils/hash.lua sobre o trade-off entre segurança e bloqueio do
# event loop antes de aumentar — o cálculo é síncrono.
PASSWORD_HASH_ITERATIONS=100000

# API key genérica (uso opcional da sua aplicação)
API_KEY=

# E-mail (SMTP) — opcional, só necessário se usar crescent.utils.mail
# (requer luarocks install luasocket luasec)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Crescent App
