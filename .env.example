APP_ENV=development
APP_DEBUG=true

# MySQL (lua-resty-mysql). Every variable used at runtime must also be listed
# with an `env NAME;` directive in nginx.conf.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=crescent_dev
DB_TEST_NAME=newcrescent_test
DB_USER=crescent
DB_PASSWORD=

JWT_SECRET=

# SMTP (crescent.mail)
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
